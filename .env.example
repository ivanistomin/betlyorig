# --- Frontend (Vite) ---
# Public Supabase URL and anon key — exposed to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=ey...

# --- Backend (Vercel serverless API only) ---
# Service role key — NEVER expose to the browser. Used by /api/* handlers.
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=ey...

# Telegram bot token (from @BotFather). Required to verify Mini App initData.
TELEGRAM_BOT_TOKEN=123456:ABC...

# Optional extra secret used to derive the per-user password we store in Supabase.
TG_AUTH_SECRET=change-me-to-a-long-random-string

# Set to "true" to allow the "dev_mode" stub login in production.
# Leave unset to only allow it during local development.
ALLOW_DEV_LOGIN=
