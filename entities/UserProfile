{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "User email (link to User entity)"
    },
    "tg_id": {
      "type": "string",
      "description": "Telegram user ID"
    },
    "tg_username": {
      "type": "string",
      "description": "Telegram username (without @)"
    },
    "tg_photo_url": {
      "type": "string",
      "description": "Telegram profile photo URL"
    },
    "tg_friends_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of Telegram friend IDs (users who joined via invite)"
    },
    "gems_balance": {
      "type": "number",
      "default": 500,
      "description": "Current GEMS balance"
    },
    "total_gems_earned": {
      "type": "number",
      "default": 0,
      "description": "Total GEMS earned over time"
    },
    "total_gems_lost": {
      "type": "number",
      "default": 0,
      "description": "Total GEMS lost from failed bets"
    },
    "bets_won": {
      "type": "number",
      "default": 0,
      "description": "Number of bets won"
    },
    "bets_lost": {
      "type": "number",
      "default": 0,
      "description": "Number of bets lost"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Current win streak"
    },
    "best_streak": {
      "type": "number",
      "default": 0,
      "description": "Best win streak ever"
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Player level"
    },
    "xp": {
      "type": "number",
      "default": 0,
      "description": "Experience points"
    },
    "achievements": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of unlocked achievement IDs"
    },
    "display_name": {
      "type": "string",
      "description": "Display name for leaderboard"
    },
    "avatar_emoji": {
      "type": "string",
      "default": "\ud83c\udfae",
      "description": "Avatar emoji (fallback if no tg photo)"
    }
  },
  "required": [
    "user_email"
  ]
}